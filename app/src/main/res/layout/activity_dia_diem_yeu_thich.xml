<?xml version="1.0" encoding="utf-8"?>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#E8F8EA">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#FFFFFF">


        <ImageView
            android:id="@+id/img_logo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:text="Việt Hành"
                android:textColor="#287D38"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="Home"
                android:textColor="#526354"
                android:textSize="10sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_bell" />

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_account_circle" />
        </LinearLayout>
    </LinearLayout>

    <!-- NỘI DUNG CÓ THỂ CUỘN -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="15dp">

            <!-- TIÊU ĐỀ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingHorizontal="13dp"
                android:paddingTop="14dp">

                <TextView
                    android:text="Địa điểm yêu thích"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="#17271B"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="12"
                    android:textSize="10sp"
                    android:textColor="#287D38"
                    android:gravity="center"

                    android:layout_width="25dp"
                    android:layout_height="25dp"/>
            </LinearLayout>

            <TextView
                android:text="12 địa điểm đã lưu vào cẩm nang du lịch xanh của bạn"
                android:textSize="12sp"
                android:textColor="#526354"
                android:paddingHorizontal="13dp"
                android:layout_marginTop="3dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- THANH TÌM KIẾM -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginHorizontal="13dp"
                android:layout_marginTop="11dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"

                >

                <TextView
                    android:text="⌕"
                    android:textSize="23sp"
                    android:textColor="#68796B"
                    android:layout_width="25dp"
                    android:layout_height="wrap_content"/>

                <EditText
                    android:id="@+id/edtSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#EAF1EA"
                    android:hint="Tìm kiếm trong mục yêu thích..."
                    android:paddingHorizontal="12dp"
                    android:singleLine="true"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="25dp"
                    android:layout_height="wrap_content"
                    android:text=" ☷ "
                    android:textColor="#68796B"
                    android:textSize="19sp" />
            </LinearLayout>

            <!-- DANH MỤC -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:scrollbars="none"
                android:paddingStart="5dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    >

                    <Button
                        android:id="@+id/tabAll"
                        android:text="Tất cả (12)"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:paddingHorizontal="15dp"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_margin="2dp"
                        android:backgroundTint="#2E7D32"/>

                    <Button
                        android:id="@+id/tabNature"
                        android:text="Thiên nhiên &amp; Núi (5)"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:layout_marginStart="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_margin="2dp"
                        android:backgroundTint="#FFFFFF"/>

                    <Button
                        android:id="@+id/tabIsland"
                        android:text="Biển đảo (4)"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:layout_marginStart="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_margin="2dp"
                        android:backgroundTint="#FFFFFF"/>
                    <Button
                        android:id="@+id/tabCaoNguyen"
                        android:text="Cao nguyên (0)"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_margin="2dp"
                        android:backgroundTint="#FFFFFF"/>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- SẮP XẾP -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="13dp">

                <TextView
                    android:id="@+id/btnSort"
                    android:text=" Sắp xếp: Mới lưu gần đây &lt;"
                    android:textSize="10sp"
                    android:textColor="#344238"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"

                    android:layout_width="wrap_content"
                    android:layout_height="28dp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>

                <TextView
                    android:text="▤"
                    android:textSize="17sp"
                    android:textColor="#287D38"
                    android:gravity="center"

                    android:layout_width="28dp"
                    android:layout_height="28dp"/>

                <TextView
                    android:text="▦"
                    android:textSize="17sp"
                    android:textColor="#89958A"
                    android:gravity="center"
                    android:layout_width="25dp"
                    android:layout_height="28dp"/>
            </LinearLayout>

            <!-- CARD VỊNH HẠ LONG -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="4dp"
                android:orientation="vertical"

                android:elevation="2dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="165dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/bg_dalat"
                        android:contentDescription="Vịnh Hạ Long"/>

                    <TextView
                        android:text="◈ Di sản UNESCO"
                        android:textSize="9sp"
                        android:textColor="#287D38"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="4dp"
                        android:layout_margin="10dp"
                        android:layout_gravity="top|start"
                        android:background="#FFFFFF"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/favoriteHaLong"
                        android:text="♥"
                        android:textSize="19sp"
                        android:textColor="#C62828"
                        android:gravity="center"

                        android:layout_gravity="top|end"
                        android:layout_margin="10dp"
                        android:layout_width="31dp"
                        android:layout_height="31dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:layout_gravity="bottom"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp"
                        android:background="#55000000">

                        <TextView
                            android:text="⌖ Hạ Long, Quảng Ninh"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:text="⭐ 4.9 (3.2k)"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="13dp"
                    android:background="@color/white">

                    <TextView
                        android:text="Vịnh Hạ Long"
                        android:textColor="#17271B"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Kỳ quan thiên nhiên thế giới với hàng nghìn đảo đá..."
                        android:textColor="#526354"
                        android:textSize="10sp"
                        android:layout_marginTop="2dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <!-- GIÁ VÉ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="27dp"
                        android:layout_marginTop="9dp"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="9dp"
                        android:background="#E8F8EA"
                        >

                        <TextView
                            android:text="▧ Vé tham quan"
                            android:textColor="#526354"
                            android:textSize="10sp"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:text="290.000đ"
                            android:textColor="#287D38"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- NÚT CHỨC NĂNG -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/detailHaLong"
                            android:text="Xem chi tiết ›"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:background="#E3F2E4"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="match_parent"/>

                        <TextView
                            android:id="@+id/addHaLong"
                            android:text="⊕ Thêm lịch trình"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:background="#2E7D32"
                            android:layout_marginStart="7dp"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="match_parent"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- CARD MÙ CANG CHẢI -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="14dp"
                android:orientation="vertical"

                android:elevation="2dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="165dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/bg_dalat"
                        android:contentDescription="Mù Cang Chải"/>

                    <TextView
                        android:text="🌾 Mùa lúa chín"
                        android:textSize="9sp"
                        android:textColor="#9A5A00"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="4dp"
                        android:layout_margin="10dp"
                        android:background="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/favoriteMuCangChai"
                        android:text="♥"
                        android:textSize="19sp"
                        android:textColor="#C62828"
                        android:gravity="center"

                        android:layout_gravity="top|end"
                        android:layout_margin="10dp"
                        android:layout_width="31dp"
                        android:layout_height="31dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:layout_gravity="bottom"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp"
                        android:background="#55000000">

                        <TextView
                            android:text="⌖ Mù Cang Chải, Yên Bái"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:text="⭐ 4.8 (1.5k)"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <TextView
                        android:text="Ruộng bậc thang Mù Cang Chải"
                        android:textColor="#17271B"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Khám phá mùa vàng giữa núi rừng Tây Bắc."
                        android:textColor="#526354"
                        android:textSize="10sp"
                        android:layout_marginTop="3dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="27dp"
                    android:layout_marginTop="9dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="9dp"
                    android:background="#E8F8EA"
                    >

                    <TextView
                        android:text="▧ Vé tham quan"
                        android:textColor="#526354"
                        android:textSize="10sp"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="290.000đ"
                        android:textColor="#287D38"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView

                        android:text="Xem chi tiết ›"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:background="#E3F2E4"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"/>

                    <TextView

                        android:text="⊕ Thêm lịch trình"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:background="#2E7D32"
                        android:layout_marginStart="7dp"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAVIGATION -->


    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        app:elevation="8dp"
        app:itemIconSize="22dp"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>
