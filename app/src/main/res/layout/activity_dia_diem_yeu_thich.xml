<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/home_toolbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/img_logo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            android:padding="5dp"
            android:src="@drawable/ic_logo_trees"
            app:tint="@color/home_action" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/app_name"
                android:textColor="@color/home_action"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/home_tab_subtitle"
                android:textColor="@color/text_sub"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_bell" />

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="16dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_account_circle"
            app:shapeAppearanceOverlay="@style/CircleImage" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="36dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/favorite_title"
                    android:textColor="@color/text_dark"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/favoriteCount"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_chip"
                    android:backgroundTint="@color/home_icon_selected"
                    android:gravity="center"
                    android:textColor="@color/home_action"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="12"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/favoriteSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                android:minHeight="18dp"
                android:textColor="@color/text_sub"
                android:textSize="13sp"
                tools:text="12 địa điểm đã lưu vào cẩm nang du lịch xanh của bạn" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_home_search" />

                <EditText
                    android:id="@+id/edtSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="start|center_vertical"
                    android:hint="@string/favorite_search_hint"
                    android:inputType="text"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/text_gray"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_filter_tune"
                    app:tint="@color/text_gray" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tabAll"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_chip"
                        android:backgroundTint="@color/green_primary"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="@string/home_catalog_all"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="Tất cả (12)" />

                    <TextView
                        android:id="@+id/tabNature"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_chip"
                        android:backgroundTint="@color/white"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="@string/favorite_category_nature"
                        android:textColor="@color/text_dark"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="Thiên nhiên &amp; Núi (5)" />

                    <TextView
                        android:id="@+id/tabIsland"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_chip"
                        android:backgroundTint="@color/white"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="@string/home_category_islands"
                        android:textColor="@color/text_dark"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="Biển đảo (4)" />

                    <TextView
                        android:id="@+id/tabCaoNguyen"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_chip"
                        android:backgroundTint="@color/white"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="@string/favorite_category_highlands"
                        android:textColor="@color/text_dark"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnSort"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_card"
                    android:backgroundTint="@color/home_icon_surface"
                    android:drawableStart="@drawable/ic_sort"
                    android:drawablePadding="5dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp"
                    android:text="@string/favorite_sort_recent"
                    android:textColor="@color/text_dark"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_card"
                    android:backgroundTint="@color/home_icon_surface"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_card"
                        android:importantForAccessibility="no"
                        android:padding="6dp"
                        android:src="@drawable/ic_favorite_list" />

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:padding="6dp"
                        android:src="@drawable/ic_favorite_grid"
                        app:tint="@color/text_sub" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:id="@+id/favoritePlacesPlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="368dp"
                        android:background="@drawable/bg_card"
                        android:clipToOutline="true">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="192dp"
                            android:background="@color/home_empty_image" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="368dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_card"
                        android:clipToOutline="true">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="192dp"
                            android:background="@color/home_empty_image" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="368dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_card"
                        android:clipToOutline="true">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="192dp"
                            android:background="@color/home_empty_image" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="368dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_card"
                        android:clipToOutline="true">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="192dp"
                            android:background="@color/home_empty_image" />
                    </FrameLayout>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/favoritePlaces"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/favoriteTip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_note_card"
                android:gravity="top"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_card"
                    android:backgroundTint="@color/green_primary"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@drawable/ic_leaf_sprout"
                    app:tint="@color/white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/favorite_tip_title"
                        android:textColor="@color/text_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/favorite_tip_body"
                        android:textColor="@color/text_sub"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/favoriteDiscover"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_card"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:minHeight="42dp"
                        android:paddingHorizontal="12dp"
                        android:text="@string/discover_places"
                        android:textColor="@color/home_action"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/home_toolbar"
        app:itemIconSize="22dp"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />
</LinearLayout>
