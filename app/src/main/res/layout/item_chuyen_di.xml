<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Tên chuyến đi và Nút thao tác -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_trip_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/layout_actions"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#191C19"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Khám phá Đà Lạt Mộng Mơ" />

            <LinearLayout
                android:id="@+id/layout_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btn_edit_trip"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="6dp"
                    android:src="@drawable/ic_edit_pencil"
                    app:tint="#2E7D32" />

                <ImageView
                    android:id="@+id/btn_delete_trip"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="6dp"
                    android:src="@drawable/ic_more_vert"
                    app:tint="#D32F2F" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Hàng Điểm đến -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_pin_green" />

            <TextView
                android:id="@+id/tv_trip_destination"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#424242"
                android:textSize="13sp"
                tools:text="Đà Lạt, Lâm Đồng" />
        </LinearLayout>

        <!-- Hàng Thời gian -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_lich_trinh" />

            <TextView
                android:id="@+id/tv_trip_dates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#2E7D32"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="15/11/2026 - 17/11/2026" />
        </LinearLayout>

        <!-- Hàng Ngân sách dự kiến -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_money_green" />

            <TextView
                android:id="@+id/tv_trip_budget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E65100"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="3.500.000 VNĐ" />
        </LinearLayout>

        <!-- Hàng Ghi chú -->
        <LinearLayout
            android:id="@+id/box_trip_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_note_card"
            android:orientation="horizontal"
            android:padding="10dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_note_doc" />

            <TextView
                android:id="@+id/tv_trip_note"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#5A6258"
                android:textSize="12sp"
                tools:text="Mang theo áo ấm, săn mây đồi Đa Phú và ăn bánh mì xíu mại." />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
